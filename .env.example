# Copy to .env.local and fill in. Never commit .env.local.

# App (also set these in Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: "Books like this" on a book's page (Claude API, server-only). Leave empty to hide it.
ANTHROPIC_API_KEY=

# Optional: Google Books for "Search online" when adding a book, and for ISBN lookups when importing
# a list into the catalog (free key from Google Cloud, "Books API"). Without it, both use Open
# Library only, which knows few Ukrainian books (and only by Latin-letter titles).
GOOGLE_BOOKS_API_KEY=

# Local scripts only (Notion import). Never set these in Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
NOTION_TOKEN=ntn_...
NOTION_DATABASE_ID=
